# Local GCE vLLM / OpenAI API Server Configuration
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY

# ReAct Agent & Baseline Hyperparameters
MAX_AGENT_HOPS=7
REACT_SEARCH_TOP_K=6
REACT_MAX_EVIDENCE_DOCUMENTS=10
REACT_MAX_OBSERVATION_CHARS=7200
BASELINE_SEARCH_TOP_K=7

# Evidence Memory Reranker (MS MARCO Cross-Encoder)
REACT_MEMORY_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
REACT_MEMORY_RERANKER_DEVICE=cpu
REACT_MEMORY_RERANKER_MAX_LENGTH=512
REACT_MEMORY_RERANKER_BATCH_SIZE=16

# Wikipedia Retrieval Settings
USER_AGENT=HotpotQAReActAgent/1.0 (contact: user@example.com)
FULLWIKI_SEARCH_CANDIDATES=20
FULLWIKI_RRF_K=60
