# LLM Configuration
# Set OPENAI_API_KEY or GROQ_API_KEY, or set OPENAI_API_BASE to point to Ollama / vLLM local instance.

# Option 1: Groq (Recommended for fast open-source inference: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: OpenAI / Open-Source Local Server (Ollama / vLLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.groq.com/openai/v1

# Selected Model
LLM_MODEL_NAME=llama-3.3-70b-versatile

# ReAct Agent Settings
MAX_AGENT_HOPS=7
USER_AGENT=HotpotQAReActAgent/1.0 (contact: user@example.com)
REACT_SEARCH_TOP_K=6
REACT_MAX_EVIDENCE_DOCUMENTS=15
REACT_MAX_OBSERVATION_CHARS=7200
