# Local GCE vLLM / OpenAI API Server Configuration
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY

# ReAct Agent & Baseline Hyperparameters
MAX_AGENT_HOPS=7
REACT_SEARCH_TOP_K=20
REACT_MAX_EVIDENCE_DOCUMENTS=20
REACT_MAX_OBSERVATION_CHARS=16000
BASELINE_SEARCH_TOP_K=7

# Evidence Memory Reranker (BAAI/bge-reranker-base Cross-Encoder)
REACT_MEMORY_RERANKER_MODEL=BAAI/bge-reranker-base
REACT_MEMORY_RERANKER_DEVICE=cuda
REACT_MEMORY_RERANKER_MAX_LENGTH=512
REACT_MEMORY_RERANKER_BATCH_SIZE=64

# Wikipedia Retrieval Settings
USER_AGENT=HotpotQAReActAgent/1.0 (contact: user@example.com)
FULLWIKI_SEARCH_CANDIDATES=60
FULLWIKI_RRF_K=60
